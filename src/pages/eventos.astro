---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/shared/PageHero.astro";
import EventsShowcase from "../components/interactive/EventsShowcase";
import Gallery from "../components/shared/Gallery.astro";
import CtaSection from "../components/shared/CtaSection.astro";
import { FaPaw, FaWhatsapp, FaSun, FaCalendarCheck, FaGlassCheers, FaGift } from "react-icons/fa";

const phone = "312 593 8264";

const annualPerks = [
  {
    icon: FaSun,
    title: "Summer Fest Canino Colima",
    desc: "Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam.",
    tag: "Verano Anual",
  },
  {
    icon: FaGlassCheers,
    title: "Dog Pool & Splash Parties",
    desc: "Lorem ipsum dolor sit amet, consectetur adipiscing elit. Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat.",
    tag: "Temporada de Calor",
  },
  {
    icon: FaGift,
    title: "Doggy Halloween & Disfraces",
    desc: "Lorem ipsum dolor sit amet, consectetur adipiscing elit. Excepteur sint occaecat cupidatat non proident, sunt in culpa qui officia deserunt.",
    tag: "Octubre de Premios",
  },
  {
    icon: FaCalendarCheck,
    title: "Fiestas de Cumpleaños Perrunos",
    desc: "Lorem ipsum dolor sit amet, consectetur adipiscing elit. Aliquam lorem ante, dapibus in viverra quis, feugiat a tellus integer feugiat.",
    tag: "Bajo Reservación",
  },
];
---

<Layout
  title="Eventos & Summer Fest Canino | Lugo Vid Colima"
  description="Descubre los eventos caninos del año en Colima: Summer Fest Canino, fiestas de alberca, concursos y convivencia para perritos felices. WhatsApp 312 593 8264"
>
  <PageHero
    eyebrow="Diversión & Convivencia Canina"
    title="Eventos del Año & Summer Fest ☀️🐾"
    subtitle="Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua."
    description="Lorem ipsum dolor sit amet, consectetur adipiscing elit. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat."
  >
    <div class="mt-8 flex flex-wrap gap-4">
      <a href="#proximos-eventos" class="btn btn-primary">
        <FaPaw className="text-base" />
        <span>Ver Próximos Eventos</span>
      </a>
      <a
        href="https://wa.me/523125938264?text=Hola%20Lugo%20Vid,%20deseo%20informaci%C3%B3n%20sobre%20el%20pr%C3%B3ximo%20evento%20canino"
        target="_blank"
        rel="noopener noreferrer"
        class="btn bg-[#25D366] text-white hover:bg-[#20ba5a]"
      >
        <FaWhatsapp className="text-lg" />
        <span>Apartar lugar al {phone}</span>
      </a>
    </div>
  </PageHero>

  <!-- Interactive Events Filter Showcase -->
  <section class="section-y bg-canvasAlt relative" id="proximos-eventos">
    <div class="container-x">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <p class="type-eyebrow text-secondary">Calendario Exclusivo</p>
        <h2 class="type-title mt-2 text-ink">
          Cartelera de Eventos Caninos
        </h2>
        <p class="type-body text-muted mt-3">
          Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.
        </p>
      </div>

      <div class="max-w-5xl mx-auto">
        <EventsShowcase client:load />
      </div>
    </div>
  </section>

  <!-- Annual Highlights Grid -->
  <section class="section-y bg-canvas relative">
    <div class="container-x">
      <div class="text-center max-w-2xl mx-auto mb-14">
        <p class="type-eyebrow text-primary">Tradición de Fiesta & Juego</p>
        <h2 class="type-title mt-2 text-ink">
          ¿Cómo vivimos cada temporada en Lugo Vid?
        </h2>
        <p class="type-body text-muted mt-3">
          Lorem ipsum dolor sit amet, consectetur adipiscing elit sed do eiusmod tempor incididunt.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {
          annualPerks.map((perk, i) => {
            const Icon = perk.icon;
            return (
              <div class="card p-6 md:p-7 flex flex-col justify-between hover:border-primary/50 group">
                <div>
                  <div class="w-12 h-12 rounded-2xl bg-secondary/10 text-secondary flex items-center justify-center text-xl mb-4 group-hover:scale-110 group-hover:bg-primary group-hover:text-white transition-all">
                    <Icon />
                  </div>
                  <span class="text-[10px] font-bold uppercase tracking-wider text-primary block mb-1">
                    {perk.tag}
                  </span>
                  <h3 class="text-lg font-bold text-ink group-hover:text-primary transition-colors">
                    {perk.title}
                  </h3>
                  <p class="text-xs text-muted leading-relaxed mt-2.5">
                    {perk.desc}
                  </p>
                </div>

                <div class="mt-6 pt-4 border-t border-line">
                  <span class="text-xs font-semibold text-secondary flex items-center gap-1">
                    🐾 Diversión 100% segura
                  </span>
                </div>
              </div>
            );
          })
        }
      </div>
    </div>
  </section>

  <!-- Photo Gallery of past dog festivals -->
  <section class="section-y bg-canvasAlt relative">
    <div class="container-x">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <p class="type-eyebrow text-secondary">Recuerdos Inolvidables</p>
        <h2 class="type-title mt-2 text-ink">
          Fotos de Nuestros Eventos Anteriores 📸
        </h2>
        <p class="type-body text-muted mt-3">
          Lorem ipsum dolor sit amet, consectetur adipiscing elit sed do eiusmod tempor incididunt ut labore.
        </p>
      </div>

      <Gallery name="gall/try" layout="mosaic" />
    </div>
  </section>

  <!-- Final CTA for events -->
  <CtaSection
    eyebrow="Cupo Limitado por Evento"
    title="¡No te quedes fuera del próximo Summer Fest Canino!"
    description="Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua."
    primaryLabel="Apartar lugar por WhatsApp"
    primaryHref="https://wa.me/523125938264?text=Hola%20Lugo%20Vid,%20deseo%20apartar%20el%20lugar%20de%20mi%20perrito%20para%20el%20pr%C3%B3ximo%20evento"
    primaryExternal={true}
    secondaryLabel="Llamar: 312 593 8264"
    secondaryHref="tel:3125938264"
  />
</Layout>
