---
import Layout from "../layouts/Layout.astro";
import InteractiveBookingCalc from "../components/interactive/InteractiveBookingCalc";
import EventsShowcase from "../components/interactive/EventsShowcase";
import Gallery from "../components/shared/Gallery.astro";
import CtaSection from "../components/shared/CtaSection.astro";
import PillarGrid from "../components/shared/PillarGrid.astro";
import { FaPaw, FaDog, FaHeart, FaWalking, FaShower, FaCarAlt, FaWhatsapp, FaMapMarkerAlt, FaPhoneAlt, FaStar, FaShieldAlt } from "react-icons/fa";
import { Image } from "astro:assets";
import placeholderImg from "../assets/images/placeholder.jpg";

const servicesList = [
  {
    icon: FaDog,
    title: "Guardería Canina",
    desc: "Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.",
    tag: "Socialización Diaria",
    color: "from-primary to-primary-dark",
  },
  {
    icon: FaHeart,
    title: "Pensión Canina",
    desc: "Lorem ipsum dolor sit amet, consectetur adipiscing elit. Ut enim ad minim veniam, quis nostrud exercitation ullamco.",
    tag: "Noches & Vacaciones",
    color: "from-secondary to-secondary-dark",
  },
  {
    icon: FaWalking,
    title: "Paseos & Ejercicio",
    desc: "Lorem ipsum dolor sit amet, consectetur adipiscing elit. Duis aute irure dolor in reprehenderit in voluptate velit esse.",
    tag: "Rutinas Activas",
    color: "from-emerald-500 to-teal-600",
  },
  {
    icon: FaShower,
    title: "Baños & Spa Canino",
    desc: "Lorem ipsum dolor sit amet, consectetur adipiscing elit. Cillum dolore eu fugiat nulla pariatur excepteur sint occaecat.",
    tag: "Higiene & Cuidado",
    color: "from-sky-500 to-blue-600",
  },
  {
    icon: FaCarAlt,
    title: "Transporte Puerta a Puerta",
    desc: "Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sunt in culpa qui officia deserunt mollit anim id est laborum.",
    tag: "En Todo Colima",
    color: "from-amber-500 to-orange-600",
  },
  {
    icon: FaPaw,
    title: "Mucha Diversión",
    desc: "Lorem ipsum dolor sit amet, consectetur adipiscing elit. Aliquam lorem ante, dapibus in viverra quis, feugiat a tellus.",
    tag: "Juegos & Alberca",
    color: "from-rose-500 to-pink-600",
  },
];

const pillars = [
  {
    title: "Atención 100% Personalizada",
    body: "Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam.",
  },
  {
    title: "Instalaciones Amplias y Seguras",
    body: "Lorem ipsum dolor sit amet, consectetur adipiscing elit. Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat.",
  },
  {
    title: "Reportes Diarios en WhatsApp",
    body: "Lorem ipsum dolor sit amet, consectetur adipiscing elit. Excepteur sint occaecat cupidatat non proident, sunt in culpa qui officia deserunt.",
  },
];

const address = "Av. Niños héroes 1275 la oriental, Colima, Mexico, 28046";
const mapUrl = "https://www.bing.com/maps/default.aspx?v=2&where1=Av.+Ni%C3%B1os+h%C3%A9roes+1275+la+oriental%2C+Colima%2C+Mexico%2C+28046";
const phone = "312 593 8264";
---

<Layout
  title="Lugo Vid | Guardería Canina, Pensión & Diversión en Colima"
  description="Pensión canina, guardería, paseos, baños, transporte y mucha diversión en Colima. Cuidamos a tu perrito como en casa. WhatsApp: 312 593 8264"
>
  <!-- Hero Section -->
  <section class="relative isolate overflow-hidden bg-gradient-to-b from-primary/10 via-canvas to-canvas pt-12 pb-20 md:pt-20 md:pb-28">
    {/* Floating Paw Watermarks */}
    <div class="pointer-events-none absolute -left-10 top-20 text-primary/10 text-9xl select-none animate-float">
      🐾
    </div>
    <div class="pointer-events-none absolute right-4 top-36 text-secondary/15 text-8xl select-none animate-paw">
      🐾
    </div>

    <div class="container-x">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <!-- Hero Text -->
        <div class="lg:col-span-7 flex flex-col items-start">
          <div class="reveal inline-flex items-center gap-2.5 px-4 py-2 rounded-full bg-white border border-secondary/30 shadow-sm text-secondary text-xs font-bold uppercase tracking-wider mb-6">
            <FaPaw className="text-sm animate-paw" />
            <span>Guardería & Pensión Canina en Colima</span>
          </div>

          <h1 class="reveal type-display text-ink text-left">
            El segundo hogar más <span class="text-primary underline decoration-secondary decoration-wavy">feliz y seguro</span> para tu perrito 🐶
          </h1>

          <p class="reveal type-body text-muted mt-6 max-w-xl text-left">
            Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip.
          </p>

          <!-- Badges highlight -->
          <div class="reveal flex flex-wrap gap-3 mt-6">
            <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-primary/10 text-primary text-xs font-semibold">
              <FaShieldAlt className="text-xs" /> Supervisión 24/7
            </span>
            <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-secondary/10 text-secondary text-xs font-semibold">
              <FaStar className="text-xs text-amber-500" /> Mucha Diversión
            </span>
            <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-amber-500/10 text-amber-600 text-xs font-semibold">
              <FaWhatsapp className="text-xs text-emerald-500" /> Reportes con fotos y videos
            </span>
          </div>

          <!-- Quick CTAs -->
          <div class="reveal flex flex-wrap items-center gap-4 mt-8">
            <a
              href="#cotizador"
              class="btn btn-primary shadow-lg shadow-primary/25"
            >
              <FaPaw className="text-base" />
              <span>Cotizar Estadía</span>
            </a>

            <a
              href="https://wa.me/523125938264?text=Hola%20Lugo%20Vid,%20me%20gustar%C3%ADa%20informaci%C3%B3n%20para%20mi%20perrito"
              target="_blank"
              rel="noopener noreferrer"
              class="btn bg-[#25D366] hover:bg-[#20ba5a] text-white shadow-lg shadow-emerald-500/20"
            >
              <FaWhatsapp className="text-xl" />
              <span>WhatsApp: {phone}</span>
            </a>
          </div>

          <!-- Quick Address snippet -->
          <a
            href={mapUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="reveal mt-6 inline-flex items-center gap-2 text-xs text-muted hover:text-primary transition-colors"
          >
            <FaMapMarkerAlt className="text-secondary text-sm" />
            <span>{address}</span>
          </a>
        </div>

        <!-- Hero Visual Interactive Card -->
        <div class="lg:col-span-5 relative">
          <div class="reveal relative rounded-3xl overflow-hidden border-4 border-white shadow-2xl bg-neutral-100">
            <Image
              src={placeholderImg}
              alt="Perritos felices jugando en Lugo Vid"
              class="w-full aspect-4/3 object-cover"
              loading="eager"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-neutral-900/80 via-transparent to-transparent"></div>

            <div class="absolute bottom-5 left-5 right-5 text-white">
              <div class="flex items-center justify-between">
                <div>
                  <span class="text-xs font-bold uppercase tracking-wider text-secondary flex items-center gap-1">
                    🐾 Lugo Vid Colima
                  </span>
                  <p class="text-base font-bold text-white mt-0.5">
                    ¡Amor, juego y cuidado responsable!
                  </p>
                </div>
                <span class="px-3 py-1 rounded-full bg-white/20 backdrop-blur-md text-xs font-semibold">
                  Abierto hoy
                </span>
              </div>
            </div>
          </div>

          <!-- Floating mini badge -->
          <div class="absolute -bottom-5 -left-5 bg-white p-4 rounded-2xl shadow-xl border border-line flex items-center gap-3">
            <div class="w-10 h-10 rounded-full bg-[#25D366]/20 text-[#25D366] flex items-center justify-center text-xl">
              <FaWhatsapp />
            </div>
            <div>
              <span class="text-[11px] text-muted block leading-none">Respuesta rápida</span>
              <span class="text-xs font-bold text-ink">312 593 8264</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Services Grid Section -->
  <section class="section-y bg-canvasAlt relative" id="servicios">
    <div class="container-x">
      <div class="text-center max-w-2xl mx-auto mb-14">
        <p class="type-eyebrow text-secondary flex items-center justify-center gap-2">
          <span>🐾</span>
          <span>Nuestros Servicios Caninos</span>
          <span>🐾</span>
        </p>
        <h2 class="type-title mt-3 text-ink">
          Todo lo que tu perrito necesita en un solo lugar
        </h2>
        <p class="type-body text-muted mt-4">
          Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
        {
          servicesList.map((service, idx) => {
            const Icon = service.icon;
            return (
              <div class="card p-7 md:p-8 flex flex-col justify-between group hover:border-primary/40">
                <div>
                  <div class="flex items-center justify-between mb-5">
                    <div class={`w-14 h-14 rounded-2xl bg-gradient-to-tr ${service.color} text-white flex items-center justify-center text-2xl shadow-md group-hover:scale-110 transition-transform`}>
                      <Icon />
                    </div>
                    <span class="text-[11px] font-bold uppercase tracking-wider px-3 py-1 rounded-full bg-neutral-100 text-neutral-600">
                      {service.tag}
                    </span>
                  </div>

                  <h3 class="type-heading text-ink group-hover:text-primary transition-colors">
                    {service.title}
                  </h3>

                  <p class="type-body text-sm text-muted mt-3 leading-relaxed">
                    {service.desc}
                  </p>
                </div>

                <div class="mt-6 pt-5 border-t border-neutral-100 flex items-center justify-between">
                  <a
                    href={`https://wa.me/523125938264?text=${encodeURIComponent(`Hola Lugo Vid, me gustaría información del servicio: ${service.title}`)}`}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-xs font-bold text-primary hover:text-primary-dark inline-flex items-center gap-1.5 transition-colors"
                  >
                    <span>Preguntar por WhatsApp</span>
                    <FaWhatsapp className="text-sm text-[#25D366]" />
                  </a>
                  <span class="text-neutral-300 text-xs">🐾 #{idx + 1}</span>
                </div>
              </div>
            );
          })
        }
      </div>
    </div>
  </section>

  <!-- Interactive Booking Calculator Section -->
  <section class="section-y bg-canvas relative" id="cotizador">
    <div class="container-x">
      <div class="text-center max-w-3xl mx-auto mb-10">
        <p class="type-eyebrow text-primary">Interactivo · Rápido · Sin compromiso</p>
        <h2 class="type-title mt-2 text-ink">
          Calcula y personaliza la estadía de tu mascota
        </h2>
        <p class="type-body text-muted mt-3">
          Lorem ipsum dolor sit amet, consectetur adipiscing elit. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris.
        </p>
      </div>

      <div class="max-w-5xl mx-auto">
        <InteractiveBookingCalc client:load />
      </div>
    </div>
  </section>

  <!-- Canine Gallery Section with Real Dogs from gall/try -->
  <section class="section-y bg-canvasAlt relative" id="galeria">
    <div class="container-x">
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-10">
        <div>
          <p class="type-eyebrow text-secondary">Momentos Reales</p>
          <h2 class="type-title mt-2 text-ink">
            Galería de Huellitas Felices 🐾
          </h2>
          <p class="type-body text-muted mt-2 max-w-xl">
            Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.
          </p>
        </div>

        <a
          href="https://instagram.com"
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-secondary shrink-0 self-start md:self-auto"
        >
          <span>Ver más en Instagram</span>
        </a>
      </div>

      <!-- PhotoSwipe Mosaic Gallery -->
      <Gallery name="gall/try" layout="mosaic" />
    </div>
  </section>

  <!-- Events & Summer Fest Showcase -->
  <section class="section-y bg-canvas relative" id="eventos">
    <div class="container-x">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-accent/15 text-accent text-xs font-bold uppercase tracking-wider mb-3">
          <span>☀️</span>
          <span>Eventos Caninos Todo el Año</span>
        </div>
        <h2 class="type-title text-ink">
          Summer Fest & Fiestas Especiales para Perritos
        </h2>
        <p class="type-body text-muted mt-3">
          Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.
        </p>
      </div>

      <div class="max-w-5xl mx-auto">
        <EventsShowcase client:visible />
      </div>
    </div>
  </section>

  <!-- Why Choose Us / Pillars Grid -->
  <section class="section-y bg-canvasAlt">
    <div class="container-x">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <p class="type-eyebrow text-secondary">Por Qué Elegir Lugo Vid</p>
        <h2 class="type-title mt-2 text-ink">
          Cuidado con amor, ciencia y responsabilidad
        </h2>
        <p class="type-body text-muted mt-3">
          Lorem ipsum dolor sit amet, consectetur adipiscing elit sed do eiusmod tempor.
        </p>
      </div>

      <PillarGrid items={pillars} columns={3} />
    </div>
  </section>

  <!-- Final CTA Section with Direct Social Action -->
  <CtaSection
    eyebrow="¡Te Esperamos en Colima!"
    title="¿Listo para consentir a tu perrito en Lugo Vid?"
    description="Lorem ipsum dolor sit amet, consectetur adipiscing elit. Escríbenos directamente por WhatsApp o visítanos en nuestras instalaciones."
    primaryLabel="Escríbenos al 312 593 8264"
    primaryHref="https://wa.me/523125938264?text=Hola%20Lugo%20Vid,%20quiero%20conocer%20m%C3%A1s%20sobre%20sus%20servicios"
    primaryExternal={true}
    secondaryLabel="Cómo Llegar (Mapa)"
    secondaryHref={mapUrl}
    secondaryExternal={true}
  />
</Layout>
