---
import Layout from "../layouts/Layout.astro";
import InteractiveBookingCalc from "../components/interactive/InteractiveBookingCalc";
import Gallery from "../components/shared/Gallery.astro";
import CtaSection from "../components/shared/CtaSection.astro";
import PillarGrid from "../components/shared/PillarGrid.astro";
import SectionHeader from "../components/shared/SectionHeader.astro";
import HeroSlider from "../components/sliders/HeroSlider.astro";
import HomeIntro from "../components/home/HomeIntro.astro";
import EventsCarousel from "../components/sliders/EventsCarousel.astro";
import OffersCarousel from "../components/sliders/OffersCarousel.astro";
import ServiceCard from "../components/cards/ServiceCard.astro";
import { FiArrowRight } from "react-icons/fi";
import { FaInstagram } from "react-icons/fa";
import { getServicios, getEventos } from "../lib/content";
import { waLink, MAP_URL } from "../lib/contact";

const servicios = (await getServicios()).filter((s) => s.data.featured).slice(0, 4);
const eventos = await getEventos();
// Featured events lead the rail; the rest follow in their own order.
const eventosRail = [...eventos.filter((e) => e.data.featured), ...eventos.filter((e) => !e.data.featured)];

const pillars = [
  {
    title: "Atención 100% personalizada",
    body: "Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.",
  },
  {
    title: "Instalaciones amplias y seguras",
    body: "Lorem ipsum dolor sit amet, consectetur adipiscing elit. Duis aute irure dolor in reprehenderit in voluptate velit esse.",
  },
  {
    title: "Reportes diarios en WhatsApp",
    body: "Lorem ipsum dolor sit amet, consectetur adipiscing elit. Excepteur sint occaecat cupidatat non proident, sunt in culpa.",
  },
];
---

<Layout
  title="Lugo Vid | Guardería Canina, Pensión & Diversión en Colima"
  description="Pensión canina, guardería, paseos, baños, transporte y mucha diversión en Colima. Cuidamos a tu perrito como en casa. WhatsApp: 312 593 8264"
>
  <HeroSlider />
  <HomeIntro />

  <section class="section-y bg-canvas-alt" id="servicios">
    <div class="container-x">
      <div class="mb-8 flex flex-col gap-4 md:mb-10 md:flex-row md:items-end md:justify-between">
        <SectionHeader
          title="Todo lo que tu perrito necesita"
          description="Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt."
        />
        <a href="/servicios" class="group inline-flex shrink-0 items-center gap-1.5 text-sm font-semibold text-primary">
          Ver todos los servicios
          <FiArrowRight className="h-4 w-4 transition-transform duration-300 ease-out group-hover:translate-x-0.5" aria-hidden="true" />
        </a>
      </div>

      <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {servicios.map((entry) => <ServiceCard entry={entry} class="reveal" />)}
      </div>
    </div>
  </section>

  {
    eventosRail.length > 0 && (
      <section class="section-y bg-canvas" id="eventos">
        <div class="container-x">
          <EventsCarousel events={eventosRail} />
        </div>
      </section>
    )
  }

  <section class="section-y bg-canvas-alt" id="ofertas">
    <div class="container-x">
      <OffersCarousel />
    </div>
  </section>

  <section class="section-y bg-canvas" id="cotizador">
    <div class="container-x">
      <SectionHeader
        align="center"
        title="Calcula la estadía de tu mascota"
        description="Lorem ipsum dolor sit amet, consectetur adipiscing elit. Ut enim ad minim veniam."
        class="mb-10"
      />
      <div class="mx-auto max-w-5xl">
        <InteractiveBookingCalc client:visible />
      </div>
    </div>
  </section>

  <section class="section-y bg-canvas-alt" id="galeria">
    <div class="container-x">
      <div class="mb-10 flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
        <SectionHeader
          title="Huellitas felices"
          description="Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt."
        />
        <a
          href="https://www.instagram.com/lugo.vid/"
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-secondary shrink-0 self-start md:self-auto"
        >
          <FaInstagram className="h-4 w-4" aria-hidden="true" />
          Ver más en Instagram
        </a>
      </div>

      <Gallery name="gall/try" layout="mosaic" />
    </div>
  </section>

  <section class="section-y bg-canvas">
    <div class="container-x">
      <SectionHeader align="center" title="Cuidado con amor y responsabilidad" class="mb-12" />
      <PillarGrid items={pillars} columns={3} />
    </div>
  </section>

  <CtaSection
    title="¿Listo para consentir a tu perrito?"
    description="Lorem ipsum dolor sit amet, consectetur adipiscing elit. Escríbenos por WhatsApp o visítanos en nuestras instalaciones."
    primaryLabel="Escríbenos por WhatsApp"
    primaryHref={waLink("Hola Lugo Vid, quiero conocer más sobre sus servicios")}
    primaryExternal={true}
    secondaryLabel="Cómo llegar"
    secondaryHref={MAP_URL}
    secondaryExternal={true}
  />
</Layout>
