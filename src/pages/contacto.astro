---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/shared/PageHero.astro";
import { FaWhatsapp, FaInstagram, FaTiktok, FaFacebookF, FaPhoneAlt, FaMapMarkerAlt, FaClock, FaExternalLinkAlt, FaPaw } from "react-icons/fa";

const phone = "312 593 8264";
const address = "Av. Niños héroes 1275 la oriental, Colima, Mexico, 28046";
const waHref = "https://wa.me/523125938264?text=Hola%20Lugo%20Vid,%20me%20comunico%20desde%20la%20p%C3%A1gina%20web%20para%20solicitar%20informaci%C3%B3n";

const socialChannels = [
  {
    name: "WhatsApp",
    handle: "Atención Inmediata",
    desc: "Lorem ipsum dolor sit amet, consectetur adipiscing elit sed do eiusmod.",
    url: waHref,
    btnText: "Escribir por WhatsApp",
    icon: FaWhatsapp,
    color: "bg-primary text-white",
    badge: "Canal Principal",
  },
  {
    name: "Instagram",
    handle: "@lugo.vid",
    desc: "Lorem ipsum dolor sit amet, consectetur adipiscing elit sed do eiusmod.",
    url: "https://www.instagram.com/lugo.vid/",
    btnText: "Ver Instagram",
    icon: FaInstagram,
    color: "bg-secondary text-white",
    badge: "Fotos & Reels",
  },
  {
    name: "TikTok",
    handle: "@lugovid2021",
    desc: "Lorem ipsum dolor sit amet, consectetur adipiscing elit sed do eiusmod.",
    url: "https://www.tiktok.com/@lugovid2021",
    btnText: "Seguir en TikTok",
    icon: FaTiktok,
    color: "bg-primary text-white",
    badge: "Videos & Trends",
  },
  {
    name: "Facebook",
    handle: "Lugovid",
    desc: "Lorem ipsum dolor sit amet, consectetur adipiscing elit sed do eiusmod.",
    url: "https://www.facebook.com/p/Lugovid-100089677875237/",
    btnText: "Ir a Facebook",
    icon: FaFacebookF,
    color: "bg-secondary text-white",
    badge: "Comunidad",
  },
];
---

<Layout
  title="Contacto & Ubicación | Lugo Vid Guardería Canina Colima"
  description="Conéctate con Lugo Vid en WhatsApp, Instagram, TikTok y Facebook. Visítanos en Av. Niños héroes 1275 la oriental, Colima."
>
  <PageHero
    eyebrow="Siempre Conectados"
    title="Contacto & Redes Sociales"
    subtitle="Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore."
    description="Lorem ipsum dolor sit amet, consectetur adipiscing elit. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat."
  />

  <!-- Main Social Media Channels Showcase (Primary Focus) -->
  <section class="section-y bg-canvasAlt relative">
    <div class="container-x">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <p class="type-eyebrow text-secondary flex items-center justify-center gap-2">
          <span>🐾</span>
          <span>Nuestros Canales Favoritos</span>
          <span>🐾</span>
        </p>
        <h2 class="type-title mt-2 text-ink">
          ¿Por dónde prefieres hablar con nosotros?
        </h2>
        <p class="type-body text-muted mt-3">
          Lorem ipsum dolor sit amet, consectetur adipiscing elit sed do eiusmod tempor.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {
          socialChannels.map((item) => {
            const Icon = item.icon;
            return (
              <div class="card p-6 md:p-7 flex flex-col justify-between group hover:border-primary/50 transition-all">
                <div>
                  <div class="flex items-center justify-between mb-4">
                    <div class={`w-12 h-12 rounded-2xl flex items-center justify-center text-2xl shadow-md group-hover:scale-110 transition-transform ${item.color}`}>
                      <Icon />
                    </div>
                    <span class="text-[10px] font-bold uppercase tracking-wider px-2.5 py-1 rounded-full bg-primary/10 text-primary">
                      {item.badge}
                    </span>
                  </div>

                  <h3 class="text-xl font-bold text-ink">
                    {item.name}
                  </h3>
                  <span class="text-xs font-semibold text-secondary block mt-0.5">
                    {item.handle}
                  </span>

                  <p class="text-xs text-muted leading-relaxed mt-3">
                    {item.desc}
                  </p>
                </div>

                <a
                  href={item.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="mt-6 w-full py-3 px-4 rounded-xl text-center text-xs font-bold uppercase tracking-wider flex items-center justify-center gap-2 bg-neutral-900 text-white hover:bg-primary transition-colors shadow-sm"
                >
                  <span>{item.btnText}</span>
                  <FaExternalLinkAlt className="text-[10px]" />
                </a>
              </div>
            );
          })
        }
      </div>
    </div>
  </section>

  <!-- Physical Location & Embedded Google Map -->
  <section class="section-y bg-canvas relative" id="ubicacion">
    <div class="container-x">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-stretch">
        <!-- Location Details Card (5 cols) -->
        <div class="lg:col-span-5 flex flex-col justify-between p-6 md:p-8 rounded-3xl bg-neutral-900 text-white border border-neutral-800 shadow-xl">
          <div>
            <div class="flex items-center gap-2 text-secondary font-bold text-xs uppercase tracking-wider mb-3">
              <FaMapMarkerAlt />
              <span>Nuestras Instalaciones</span>
            </div>

            <h3 class="text-2xl font-bold text-white mb-2">
              Lugo Vid en Colima, México 🐾
            </h3>

            <p class="text-xs text-neutral-400 leading-relaxed mb-6">
              Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.
            </p>

            <div class="space-y-4 pt-4 border-t border-neutral-800 text-xs">
              <div class="flex items-start gap-3">
                <FaMapMarkerAlt className="text-secondary text-base shrink-0 mt-0.5" />
                <div>
                  <span class="font-bold text-white block">Dirección:</span>
                  <p class="text-neutral-300 mt-0.5">{address}</p>
                </div>
              </div>

              <div class="flex items-start gap-3">
                <FaPhoneAlt className="text-primary text-base shrink-0 mt-0.5" />
                <div>
                  <span class="font-bold text-white block">Teléfono / WhatsApp:</span>
                  <p class="text-neutral-300 mt-0.5">{phone}</p>
                </div>
              </div>

              <div class="flex items-start gap-3">
                <FaClock className="text-secondary text-base shrink-0 mt-0.5" />
                <div>
                  <span class="font-bold text-white block">Horario de Servicio:</span>
                  <p class="text-neutral-300 mt-0.5">Lunes a Domingo: 7:30 AM - 7:30 PM</p>
                </div>
              </div>
            </div>
          </div>

          <div class="mt-8 pt-6 border-t border-neutral-800 flex flex-col gap-3">
            <a
              href={waHref}
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-primary w-full justify-center text-xs uppercase tracking-wider"
            >
              <FaWhatsapp className="text-base" />
              <span>Escribir por WhatsApp</span>
            </a>

            <a
              href="tel:3125938264"
              class="btn btn-secondary w-full justify-center text-xs uppercase tracking-wider"
            >
              <FaPhoneAlt className="text-sm" />
              <span>Llamar ahora</span>
            </a>
          </div>
        </div>

        <!-- Google Maps Iframe (7 cols) -->
        <div class="lg:col-span-7 flex flex-col">
          <div class="relative w-full h-full min-h-[420px] rounded-3xl overflow-hidden border border-line shadow-xl bg-neutral-100">
            <iframe
              src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3767.045874013869!2d-103.7038605!3d19.2368324!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x842551005543eb79%3A0xac567cd63fd16631!2sLugoVID!5e0!3m2!1ses-419!2smx!4v1791473037030!5m2!1ses-419!2smx"
              class="w-full h-full min-h-[420px] border-0"
              allowfullscreen=""
              loading="lazy"
              referrerpolicy="strict-origin-when-cross-origin"
              title="Ubicación de Lugo Vid en Google Maps"
            ></iframe>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
