---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import FloatingSocials from "../components/interactive/FloatingSocials";
import ScrollReveal from "../components/shared/ScrollReveal.astro";
import AnnouncementBar from "../components/shared/AnnouncementBar.astro";
import { SEO } from "astro-seo";

interface Props {
  title?: string;
  description?: string;
  /** Social share image: a local asset (`cover.src`) or an absolute URL. */
  image?: string;
  imageAlt?: string;
  /** `article` for detail pages. */
  type?: "website" | "article";
  noindex?: boolean;
}

const {
  title = "Lugo Vid | Guardería & Pensión Canina en Colima",
  description = "Guardería canina, pensión, paseos, baños, transporte y mucha diversión en Colima. Atención amorosa y profesional para tu mascota.",
  image = "/logo.png",
  imageAlt = "Lugo Vid, estancia canina en Colima",
  type = "website",
  noindex = false,
} = Astro.props;

// Absolute URLs for crawlers; `site` comes from astro.config.mjs.
const base = Astro.site ?? Astro.url;
const canonical = new URL(Astro.url.pathname, base);
const ogImage = new URL(image, base).href;
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/ico.png" />
    <ClientRouter />
    <meta name="generator" content={Astro.generator} />
    <SEO
      title={title}
      description={description}
      canonical={canonical}
      noindex={noindex}
      openGraph={{
        basic: { title, type, image: ogImage, url: canonical },
        optional: { description, siteName: "Lugo Vid", locale: "es_MX" },
        image: { alt: imageAlt },
      }}
      twitter={{ card: "summary_large_image", title, description, image: ogImage, imageAlt }}
    />

    <!-- Dark Mode Initializer Script (No-flash) -->
    <script is:inline>
      function applyTheme() {
        const stored = typeof localStorage !== "undefined" ? localStorage.getItem("theme") : null;
        const isDark = stored === "dark" || (!stored && window.matchMedia("(prefers-color-scheme: dark)").matches);
        document.documentElement.classList.toggle("dark", isDark);
      }
      applyTheme();
      document.addEventListener("astro:after-swap", applyTheme);
    </script>
  </head>
  <body class="min-h-screen flex flex-col bg-canvas text-ink antialiased selection:bg-primary/20 selection:text-primary-ink transition-colors duration-300">
    <AnnouncementBar />
    <Navbar />

    <main class="flex-1">
      <slot />
    </main>

    <Footer />

    <!-- Botón flotante de atención inmediata en la esquina inferior derecha -->
    <FloatingSocials client:load />

    <!-- Intersection observer scroll reveal trigger -->
    <ScrollReveal />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
  }
</style>
