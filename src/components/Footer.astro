---
import { FaWhatsapp, FaInstagram, FaTiktok, FaFacebookF, FaPhoneAlt, FaMapMarkerAlt, FaPaw, FaClock, FaHeart } from "react-icons/fa";
import { Image } from "astro:assets";
import logoImg from "../assets/images/logo.png";

const address = "Av. Niños héroes 1275 la oriental, Colima, Mexico, 28046";
const mapUrl = "https://www.bing.com/maps/default.aspx?v=2&where1=Av.+Ni%C3%B1os+h%C3%A9roes+1275+la+oriental%2C+Colima%2C+Mexico%2C+28046";
const waHref = "https://wa.me/523125938264?text=Hola%20Lugo%20Vid,%20me%20gustar%C3%ADa%20informaci%C3%B3n%20sobre%20sus%20servicios%20caninos";
---

<footer class="relative overflow-hidden bg-neutral-900 text-white pt-16 pb-12 border-t border-neutral-800">
  <!-- Decorative dog paw prints watermark -->
  <div class="pointer-events-none absolute -right-12 -top-12 text-neutral-800/40 text-9xl select-none">
    🐾
  </div>
  <div class="pointer-events-none absolute left-10 bottom-6 text-neutral-800/30 text-8xl select-none">
    🐾
  </div>

  <div class="container-x relative">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-10 pb-12 border-b border-neutral-800">
      <!-- Col 1: Brand & Philosophy -->
      <div class="lg:col-span-4">
        <a href="/" class="inline-flex items-center gap-3 group">
          <div class="h-16 w-auto flex items-center">
            <Image
              src={logoImg}
              alt="Lugo Vid Guardería Canina"
              class="h-full w-auto max-h-16 object-contain"
            />
          </div>
        </a>

        <p class="mt-4 text-sm text-neutral-400 leading-relaxed max-w-sm">
          Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam.
        </p>

        <!-- Social Media Themed with Primary & Secondary -->
        <div class="mt-6 flex flex-wrap items-center gap-2.5">
          <a
            href={waHref}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="WhatsApp"
            title="WhatsApp"
            class="flex h-10 w-10 items-center justify-center rounded-full bg-primary/20 text-primary border border-primary/30 hover:bg-primary hover:text-white transition-all duration-300 shadow-sm hover:scale-110"
          >
            <FaWhatsapp className="text-xl" />
          </a>
          <a
            href="https://www.facebook.com/p/Lugovid-100089677875237/"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Facebook"
            title="Facebook"
            class="flex h-10 w-10 items-center justify-center rounded-full bg-secondary/20 text-secondary border border-secondary/30 hover:bg-secondary hover:text-white transition-all duration-300 shadow-sm hover:scale-110"
          >
            <FaFacebookF className="text-lg" />
          </a>
          <a
            href="https://www.instagram.com/lugo.vid/"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Instagram"
            title="Instagram"
            class="flex h-10 w-10 items-center justify-center rounded-full bg-primary/20 text-primary border border-primary/30 hover:bg-primary hover:text-white transition-all duration-300 shadow-sm hover:scale-110"
          >
            <FaInstagram className="text-lg" />
          </a>
          <a
            href="https://www.tiktok.com/@lugovid2021"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="TikTok"
            title="TikTok"
            class="flex h-10 w-10 items-center justify-center rounded-full bg-secondary/20 text-secondary border border-secondary/30 hover:bg-secondary hover:text-white transition-all duration-300 shadow-sm hover:scale-110"
          >
            <FaTiktok className="text-lg" />
          </a>
          <a
            href="tel:3125938264"
            aria-label="Llamar"
            title="Llamar"
            class="flex h-10 w-10 items-center justify-center rounded-full bg-primary/20 text-primary border border-primary/30 hover:bg-primary hover:text-white transition-all duration-300 shadow-sm hover:scale-110"
          >
            <FaPhoneAlt className="text-base" />
          </a>
        </div>
      </div>

      <!-- Col 2: Quick Links -->
      <div class="lg:col-span-2">
        <h4 class="text-sm font-bold uppercase tracking-wider text-white mb-4 flex items-center gap-2">
          <span class="h-1.5 w-1.5 rounded-full bg-secondary"></span>
          Navegación
        </h4>
        <ul class="space-y-2.5 text-sm text-neutral-400">
          <li>
            <a href="/" class="hover:text-secondary transition-colors">Inicio</a>
          </li>
          <li>
            <a href="/servicios" class="hover:text-secondary transition-colors">Nuestros Servicios</a>
          </li>
          <li>
            <a href="/eventos" class="hover:text-secondary transition-colors">Eventos</a>
          </li>
          <li>
            <a href="/acerca-de" class="hover:text-secondary transition-colors">Quiénes Somos</a>
          </li>
          <li>
            <a href="/contacto" class="hover:text-secondary transition-colors">Contacto</a>
          </li>
        </ul>
      </div>

      <!-- Col 3: Services Summary -->
      <div class="lg:col-span-3">
        <h4 class="text-sm font-bold uppercase tracking-wider text-white mb-4 flex items-center gap-2">
          <span class="h-1.5 w-1.5 rounded-full bg-primary"></span>
          Servicios Caninos
        </h4>
        <ul class="space-y-2 text-sm text-neutral-400">
          <li class="flex items-center gap-2">
            <span class="text-xs text-secondary">🐾</span> Guardería Canina
          </li>
          <li class="flex items-center gap-2">
            <span class="text-xs text-secondary">🐾</span> Pensión Canina
          </li>
          <li class="flex items-center gap-2">
            <span class="text-xs text-secondary">🐾</span> Paseos & Ejercicio
          </li>
          <li class="flex items-center gap-2">
            <span class="text-xs text-secondary">🐾</span> Baños & Spa Relajante
          </li>
          <li class="flex items-center gap-2">
            <span class="text-xs text-secondary">🐾</span> Transporte Canino
          </li>
          <li class="flex items-center gap-2">
            <span class="text-xs text-secondary">🐾</span> Mucha Diversión
          </li>
        </ul>
      </div>

      <!-- Col 4: Location & Direct Contact -->
      <div class="lg:col-span-3">
        <h4 class="text-sm font-bold uppercase tracking-wider text-white mb-4 flex items-center gap-2">
          <span class="h-1.5 w-1.5 rounded-full bg-secondary"></span>
          Visítanos en Colima
        </h4>
        <div class="space-y-3.5 text-xs text-neutral-300">
          <a
            href={mapUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-start gap-2.5 hover:text-white transition-colors group"
          >
            <FaMapMarkerAlt className="text-secondary text-base shrink-0 mt-0.5 group-hover:scale-110 transition-transform" />
            <span>{address}</span>
          </a>

          <div class="flex items-start gap-2.5 text-neutral-400">
            <FaClock className="text-secondary text-sm shrink-0 mt-0.5" />
            <div>
              <p class="font-semibold text-neutral-200">Lunes a Domingo:</p>
              <p>7:30 AM - 7:30 PM</p>
            </div>
          </div>
        </div>

        <a
          href={waHref}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-5 inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-primary hover:bg-primary-dark text-white font-bold text-xs shadow-md transition-all hover:scale-105"
        >
          <FaWhatsapp className="text-base" />
          <span>Escríbenos por WhatsApp</span>
        </a>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="mt-8 flex flex-col md:flex-row items-center justify-between gap-4 text-xs text-neutral-500">
      <div class="flex items-center gap-1.5">
        <span>© {new Date().getFullYear()} Lugo Vid Guardería Canina. Todos los derechos reservados. Hecho con</span>
        <FaHeart className="text-red-500 inline text-xs" />
        <span>para perritos felices.</span>
      </div>
      <div class="flex items-center gap-4">
        <a href="/contacto" class="hover:text-neutral-400">
          Colima, México
        </a>
      </div>
    </div>
  </div>
</footer>
