---
import { FaWhatsapp, FaInstagram, FaTiktok, FaFacebookF, FaPhoneAlt, FaBars, FaTimes, FaPaw } from "react-icons/fa";
import ThemeToggle from "./shared/ThemeToggle.astro";

const currentPath = Astro.url.pathname;

const navLinks = [
  { href: "/", label: "Inicio" },
  { href: "/servicios", label: "Servicios" },
  { href: "/eventos", label: "Eventos & Summer Fest" },
  { href: "/acerca-de", label: "Nosotros" },
  { href: "/contacto", label: "Contacto" },
];

const phone = "312 593 8264";
const waHref = "https://wa.me/523125938264?text=Hola%20Lugo%20Vid,%20me%20gustar%C3%ADa%20informaci%C3%B3n%20sobre%20sus%20servicios%20caninos";
---

<header class="sticky top-0 z-40 w-full border-b border-line/80 bg-white/90 backdrop-blur-md transition-all">
  <div class="container-x flex h-20 items-center justify-between">
    <!-- Brand / Logo -->
    <a href="/" class="group flex items-center gap-3">
      <div class="relative flex h-11 w-11 items-center justify-center rounded-2xl bg-gradient-to-tr from-primary to-secondary text-white shadow-md shadow-primary/20 transition-transform duration-300 group-hover:scale-105">
        <FaPaw className="text-2xl animate-paw" />
        <span class="absolute -right-1 -top-1 flex h-3.5 w-3.5">
          <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-accent opacity-75"></span>
          <span class="relative inline-flex h-3.5 w-3.5 rounded-full bg-accent"></span>
        </span>
      </div>
      <div class="flex flex-col">
        <span class="text-xl font-extrabold tracking-tight text-ink group-hover:text-primary transition-colors flex items-center gap-1.5">
          Lugo Vid
          <span class="text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded-full bg-primary/10 text-primary">
            Canino
          </span>
        </span>
        <span class="text-[11px] font-semibold text-secondary tracking-wider uppercase">
          Guardería & Pensión
        </span>
      </div>
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden md:flex items-center gap-1 lg:gap-2">
      {
        navLinks.map((link) => {
          const isActive = currentPath === link.href || (link.href !== "/" && currentPath.startsWith(link.href));
          return (
            <a
              href={link.href}
              class:list={[
                "px-3.5 py-2 rounded-full text-xs lg:text-sm font-semibold transition-all duration-200",
                isActive
                  ? "bg-primary/10 text-primary font-bold shadow-xs"
                  : "text-muted hover:text-ink hover:bg-neutral-100/70",
              ]}
            >
              {link.label}
            </a>
          );
        })
      }
    </nav>

    <!-- Socials & Quick Actions -->
    <div class="hidden md:flex items-center gap-3">
      <!-- Quick Social Icons -->
      <div class="flex items-center gap-1.5 border-r border-line pr-3">
        <a
          href="https://facebook.com"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Facebook"
          class="flex h-8 w-8 items-center justify-center rounded-full text-muted hover:bg-[#1877F2]/10 hover:text-[#1877F2] transition-colors"
        >
          <FaFacebookF className="text-sm" />
        </a>
        <a
          href="https://instagram.com"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Instagram"
          class="flex h-8 w-8 items-center justify-center rounded-full text-muted hover:bg-[#E4405F]/10 hover:text-[#E4405F] transition-colors"
        >
          <FaInstagram className="text-sm" />
        </a>
        <a
          href="https://tiktok.com"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="TikTok"
          class="flex h-8 w-8 items-center justify-center rounded-full text-muted hover:bg-black/10 hover:text-black transition-colors"
        >
          <FaTiktok className="text-sm" />
        </a>
      </div>

      <!-- WhatsApp Direct CTA -->
      <a
        href={waHref}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 rounded-full bg-[#25D366] px-4 py-2 text-xs lg:text-sm font-bold text-white shadow-md shadow-emerald-500/20 hover:bg-[#20ba5a] hover:scale-105 transition-all"
      >
        <FaWhatsapp className="text-lg" />
        <span class="hidden lg:inline">WhatsApp:</span>
        <span>{phone}</span>
      </a>
    </div>

    <!-- Mobile Menu Button -->
    <div class="flex items-center gap-2 md:hidden">
      <a
        href={waHref}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Contactar por WhatsApp"
        class="flex h-10 w-10 items-center justify-center rounded-full bg-[#25D366] text-white shadow-md"
      >
        <FaWhatsapp className="text-xl" />
      </a>
      <button
        type="button"
        id="mobile-menu-btn"
        aria-label="Abrir menú de navegación"
        class="flex h-10 w-10 items-center justify-center rounded-xl border border-line bg-canvas text-ink hover:bg-neutral-100 transition-colors cursor-pointer"
      >
        <FaBars className="text-lg" id="menu-icon-bars" />
        <FaTimes className="text-lg hidden" id="menu-icon-times" />
      </button>
    </div>
  </div>

  <!-- Mobile Drawer Menu -->
  <div
    id="mobile-menu"
    class="hidden md:hidden border-t border-line bg-white/95 px-5 py-6 backdrop-blur-md transition-all shadow-xl"
  >
    <nav class="flex flex-col gap-2">
      {
        navLinks.map((link) => {
          const isActive = currentPath === link.href || (link.href !== "/" && currentPath.startsWith(link.href));
          return (
            <a
              href={link.href}
              class:list={[
                "flex items-center justify-between px-4 py-3 rounded-2xl text-sm font-bold transition-all",
                isActive
                  ? "bg-primary text-white shadow-md"
                  : "text-ink hover:bg-neutral-100",
              ]}
            >
              <span>{link.label}</span>
              <FaPaw className={isActive ? "text-white" : "text-primary/30"} />
            </a>
          );
        })
      }
    </nav>

    <!-- Social links in mobile drawer -->
    <div class="mt-6 pt-5 border-t border-line">
      <div class="text-xs font-bold text-muted uppercase tracking-wider mb-3">
        Síguenos y conéctate:
      </div>
      <div class="grid grid-cols-4 gap-2 mb-4">
        <a
          href="https://facebook.com"
          target="_blank"
          rel="noopener noreferrer"
          class="flex flex-col items-center justify-center p-2.5 rounded-xl bg-neutral-50 text-neutral-700 hover:text-[#1877F2]"
        >
          <FaFacebookF className="text-lg" />
          <span class="text-[10px] mt-1 font-semibold">Facebook</span>
        </a>
        <a
          href="https://instagram.com"
          target="_blank"
          rel="noopener noreferrer"
          class="flex flex-col items-center justify-center p-2.5 rounded-xl bg-neutral-50 text-neutral-700 hover:text-[#E4405F]"
        >
          <FaInstagram className="text-lg" />
          <span class="text-[10px] mt-1 font-semibold">Instagram</span>
        </a>
        <a
          href="https://tiktok.com"
          target="_blank"
          rel="noopener noreferrer"
          class="flex flex-col items-center justify-center p-2.5 rounded-xl bg-neutral-50 text-neutral-700 hover:text-black"
        >
          <FaTiktok className="text-lg" />
          <span class="text-[10px] mt-1 font-semibold">TikTok</span>
        </a>
        <a
          href="tel:3125938264"
          class="flex flex-col items-center justify-center p-2.5 rounded-xl bg-neutral-50 text-neutral-700 hover:text-primary"
        >
          <FaPhoneAlt className="text-lg" />
          <span class="text-[10px] mt-1 font-semibold">Llamar</span>
        </a>
      </div>

      <a
        href={waHref}
        target="_blank"
        rel="noopener noreferrer"
        class="w-full flex items-center justify-center gap-2 py-3 px-4 rounded-2xl bg-[#25D366] text-white font-bold text-sm shadow-md"
      >
        <FaWhatsapp className="text-xl" />
        <span>Escríbenos: 312 593 8264</span>
      </a>
    </div>
  </div>
</header>

<script>
  function setupMenu() {
    const btn = document.getElementById("mobile-menu-btn");
    const menu = document.getElementById("mobile-menu");
    const iconBars = document.getElementById("menu-icon-bars");
    const iconTimes = document.getElementById("menu-icon-times");

    if (btn && menu) {
      btn.addEventListener("click", () => {
        const isHidden = menu.classList.contains("hidden");
        if (isHidden) {
          menu.classList.remove("hidden");
          iconBars?.classList.add("hidden");
          iconTimes?.classList.remove("hidden");
        } else {
          menu.classList.add("hidden");
          iconBars?.classList.remove("hidden");
          iconTimes?.classList.add("hidden");
        }
      });
    }
  }

  document.addEventListener("astro:page-load", setupMenu);
</script>
