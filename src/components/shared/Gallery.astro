---
import { Image } from "astro:assets";
import { FiMaximize2 } from "react-icons/fi";

interface Props {
  /** Folder name inside `src/assets/` — e.g. `gall/try`. */
  name: string;
  /** Accessible label for the group; also rendered when `showTitle`. */
  title?: string;
  eyebrow?: string;
  /** `mosaic` gives the first image a hero cell; `grid` keeps every cell equal. */
  layout?: "mosaic" | "grid";
  class?: string;
}

const {
  name,
  title,
  eyebrow,
  layout = "mosaic",
  class: className = "",
} = Astro.props;

const modules = import.meta.glob<{ default: ImageMetadata }>(
  "../../assets/**/*.{jpg,jpeg,png,webp,avif,JPG,JPEG,PNG}",
  { eager: true },
);

/** Turns `image-name.jpg` into `Image name`. */
const toLabel = (path: string) =>
  path
    .split("/")
    .pop()!
    .replace(/\.(jpe?g|png|webp|avif)/gi, "")
    .replace(/[-_]+/g, " ")
    .replace(/\s+/g, " ")
    .trim()
    .replace(/^./, (c) => c.toUpperCase());

const images = Object.entries(modules)
  .filter(([path]) => path.includes(`/assets/${name}/`) || path.includes(`/${name}/`))
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([path, mod]) => ({ src: mod.default, label: toLabel(path) }));

const galleryId = `pswp-${name.replace(/[^a-zA-Z0-9]/g, "-").toLowerCase()}`;

/**
 * Mosaic rhythm for mobile-first: base 1-2 columns, md: 6 columns
 */
const mosaicSpans = [
  "md:col-span-4 md:row-span-2",
  "md:col-span-2",
  "md:col-span-2",
  "md:col-span-3",
  "md:col-span-3",
  "md:col-span-2",
  "md:col-span-4",
  "md:col-span-2",
];
---

{
  images.length > 0 && (
    <figure class:list={["not-prose", className]}>
      {(eyebrow || title) && (
        <figcaption class="mb-8">
          {eyebrow && (
            <p class="type-eyebrow text-secondary flex items-center gap-2">
              <span class="inline-block w-6 h-0.5 bg-secondary"></span>
              {eyebrow}
            </p>
          )}
          {title && <h2 class="type-heading mt-2 text-ink">{title}</h2>}
        </figcaption>
      )}

      <div
        id={galleryId}
        data-pswp-gallery
        class:list={[
          "grid auto-rows-[13rem] grid-cols-1 gap-4 md:auto-rows-[12rem] lg:auto-rows-[14rem]",
          layout === "mosaic" ? "grid-cols-2 md:grid-cols-6" : "grid-cols-2 md:grid-cols-3",
        ]}
      >
        {images.map(({ src, label }, i) => (
          <a
            href={src.src}
            data-pswp-width={src.width}
            data-pswp-height={src.height}
            data-pswp-caption={label}
            target="_blank"
            rel="noreferrer"
            aria-label={label}
            class:list={[
              "group relative block overflow-hidden rounded-2xl bg-panelAlt shadow-e1 transition-all duration-300 hover:shadow-lg focus-visible:outline-offset-4",
              layout === "mosaic"
                ? mosaicSpans[i % mosaicSpans.length]
                : "md:col-span-1",
              layout === "mosaic" && i === 0 && "col-span-2 row-span-2",
            ]}
          >
            <Image
              src={src}
              alt={label}
              widths={[400, 800, 1200]}
              sizes="(min-width: 1024px) 40vw, (min-width: 768px) 50vw, 92vw"
              loading={i < 2 ? "eager" : "lazy"}
              class="h-full w-full object-cover transition-transform duration-700 ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:scale-105"
            />

            {/* Scrim + affordance */}
            <span
              class="pointer-events-none absolute inset-0 bg-gradient-to-t from-baseBlack/70 via-baseBlack/10 to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100 group-focus-visible:opacity-100"
              aria-hidden="true"
            />
            <span
              class="pointer-events-none absolute bottom-3 left-4 right-4 flex items-center justify-between gap-3 translate-y-2 opacity-0 transition-all duration-300 ease-out group-hover:translate-y-0 group-hover:opacity-100 group-focus-visible:translate-y-0 group-focus-visible:opacity-100"
              aria-hidden="true"
            >
              <span class="type-label text-white font-medium">{label}</span>
              <FiMaximize2 className="h-4 w-4 shrink-0 text-white" />
            </span>
          </a>
        ))}
      </div>
    </figure>
  )
}

<script>
  import PhotoSwipeLightbox from "photoswipe/lightbox";
  import "photoswipe/style.css";

  let lightboxes: PhotoSwipeLightbox[] = [];

  function initGalleries() {
    destroyGalleries();

    document
      .querySelectorAll<HTMLElement>("[data-pswp-gallery]")
      .forEach((el) => {
        const lb = new PhotoSwipeLightbox({
          gallery: `#${el.id}`,
          children: "a",
          bgOpacity: 0.92,
          pswpModule: () => import("photoswipe"),
        });

        lb.on("uiRegister", () => {
          lb.pswp?.ui?.registerElement({
            name: "caption",
            order: 9,
            isButton: false,
            appendTo: "root",
            html: "",
            onInit: (el, pswp) => {
              el.classList.add("pswp-caption");
              pswp.on("change", () => {
                el.textContent =
                  pswp.currSlide?.data.element?.dataset.pswpCaption ?? "";
              });
            },
          });
        });

        lb.init();
        lightboxes.push(lb);
      });
  }

  function destroyGalleries() {
    lightboxes.forEach((lb) => lb.destroy());
    lightboxes = [];
  }

  document.addEventListener("astro:page-load", initGalleries);
  document.addEventListener("astro:before-swap", destroyGalleries);
</script>

<style is:global>
  .pswp-caption {
    position: absolute;
    bottom: 1.25rem;
    left: 50%;
    transform: translateX(-50%);
    max-width: min(40rem, 90vw);
    text-align: center;
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    color: rgb(255 255 255 / 0.9);
    text-shadow: 0 1px 12px rgb(0 0 0 / 0.8);
  }
</style>
