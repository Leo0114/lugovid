---
import { Image } from "astro:assets";

interface Props {
  title: string;
  subtitle?: string;
  image: ImageMetadata;
  imageAlt?: string;
}

const { title, subtitle, image, imageAlt = "" } = Astro.props;
---

<section class="relative isolate overflow-hidden bg-primary">
  <Image
    src={image}
    alt={imageAlt}
    widths={[640, 1024, 1600]}
    sizes="100vw"
    loading="eager"
    class="absolute inset-0 -z-10 h-full w-full object-cover"
  />
  <div
    class="absolute inset-0 -z-10 bg-gradient-to-r from-baseBlack/90 via-primary/80 to-secondary/60"
    aria-hidden="true"
  >
  </div>
  <div
    class="absolute inset-0 -z-10 bg-gradient-to-t from-baseBlack/60 via-transparent to-transparent"
    aria-hidden="true"
  >
  </div>

  <div class="container-x py-20 md:py-24 lg:py-28 relative">
    {/* Floating playful dog paw decorations */}
    <div class="pointer-events-none absolute right-6 top-8 opacity-20 text-white text-5xl animate-float select-none">
      🐾
    </div>
    {
      subtitle && (
        <p class="type-eyebrow mb-4 text-secondary font-bold tracking-widest">{subtitle}</p>
      )
    }
    <h1 class="type-display max-w-3xl text-white">
      {title}
    </h1>
    <span class="mt-6 block h-1.5 w-24 rounded-full bg-secondary"></span>
  </div>
</section>
