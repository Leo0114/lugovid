---
/**
 * The original home hero, now the introduction right under <HeroSlider>.
 * The slider owns the page h1, so this block opens with an h2.
 */
import { Image } from "astro:assets";
import { FaPaw, FaWhatsapp, FaMapMarkerAlt, FaStar, FaShieldAlt } from "react-icons/fa";
import placeholderImg from "@/assets/images/placeholder.jpg";
import { waLink, ADDRESS, MAP_URL } from "@/lib/contact";

interface Props {
  image?: ImageMetadata;
  imageAlt?: string;
}

const { image = placeholderImg, imageAlt = "Perritos felices jugando en Lugo Vid" } = Astro.props;

const badges = [
  { icon: FaShieldAlt, label: "Supervisión 24/7", tone: "bg-primary/10 text-primary-ink dark:bg-primary/20" },
  { icon: FaStar, label: "Mucha diversión", tone: "bg-secondary/12 text-secondary-ink dark:bg-secondary/20" },
  { icon: FaWhatsapp, label: "Reportes con fotos y videos", tone: "bg-accent/15 text-amber-700 dark:bg-accent/20 dark:text-accent" },
];
---

<section class="relative isolate overflow-hidden bg-linear-to-b from-primary/10 via-canvas to-canvas py-16 md:py-24">
  <FaPaw
    className="animate-float pointer-events-none absolute -left-10 top-16 -z-10 h-40 w-40 -rotate-12 text-primary/8"
    aria-hidden="true"
  />
  <FaPaw
    className="animate-paw pointer-events-none absolute right-4 top-24 -z-10 h-28 w-28 rotate-12 text-secondary/12"
    aria-hidden="true"
  />

  <div class="container-x">
    <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-12">
      <div class="flex flex-col items-start lg:col-span-7">
        <p class="reveal mb-6 inline-flex items-center gap-2.5 rounded-full bg-panel px-4 py-2 text-xs font-bold uppercase tracking-wider text-secondary-ink shadow-sm ring-1 ring-secondary/30">
          <FaPaw className="animate-paw text-sm" aria-hidden="true" />
          Guardería y pensión canina en Colima
        </p>

        <h2 class="reveal type-display text-balance text-ink">
          El segundo hogar más{" "}
          <span class="text-primary-ink underline decoration-secondary decoration-wavy underline-offset-[0.18em]">feliz y seguro</span>
          {" "}para tu perrito
        </h2>

        <p class="reveal type-body mt-6 max-w-xl text-muted">
          Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.
        </p>

        <ul class="reveal mt-6 flex flex-wrap gap-2.5">
          {
            badges.map(({ icon: Icon, label, tone }) => (
              <li class:list={["inline-flex items-center gap-1.5 rounded-xl px-3 py-1.5 text-xs font-semibold", tone]}>
                <Icon className="text-xs" aria-hidden="true" />
                {label}
              </li>
            ))
          }
        </ul>

        <div class="reveal mt-8 flex flex-wrap items-center gap-3">
          <a href="#cotizador" class="btn btn-primary">
            <FaPaw className="text-base" aria-hidden="true" />
            Cotizar estadía
          </a>
          <a
            href={waLink()}
            target="_blank"
            rel="noopener noreferrer"
            class="btn bg-[#25D366] text-[#06361b] hover:bg-[#2ee072]"
          >
            <FaWhatsapp className="text-xl" aria-hidden="true" />
            WhatsApp
          </a>
        </div>

        <a
          href={MAP_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="reveal mt-6 inline-flex items-center gap-2 text-xs text-muted transition-colors hover:text-primary-ink"
        >
          <FaMapMarkerAlt className="text-sm text-secondary-ink" aria-hidden="true" />
          {ADDRESS}
        </a>
      </div>

      <div class="relative lg:col-span-5">
        <div class="reveal relative overflow-hidden rounded-3xl bg-panel-alt shadow-e2 ring-4 ring-panel">
          <Image
            src={image}
            alt={imageAlt}
            widths={[480, 800, 1200]}
            sizes="(min-width: 1024px) 40vw, 92vw"
            class="aspect-4/3 w-full object-cover"
          />
          <div class="absolute inset-0 bg-linear-to-t from-baseBlack/80 via-transparent to-transparent" aria-hidden="true"></div>

          <div class="absolute inset-x-5 bottom-5 flex items-end justify-between gap-3 text-white">
            <div>
              <p class="flex items-center gap-1.5 text-xs font-bold text-secondary-ink">
                <FaPaw aria-hidden="true" /> Lugo Vid Colima
              </p>
              <p class="mt-0.5 text-base font-bold">Amor, juego y cuidado responsable</p>
            </div>
            <span class="shrink-0 rounded-full bg-white/20 px-3 py-1 text-xs font-semibold backdrop-blur-md">
              Abierto hoy
            </span>
          </div>
        </div>

        <div class="absolute -bottom-5 -left-3 flex items-center gap-3 rounded-2xl bg-panel p-4 shadow-e2 ring-1 ring-line md:-left-5">
          <span class="flex h-10 w-10 items-center justify-center rounded-full bg-primary/10 text-xl text-primary-ink">
            <FaWhatsapp aria-hidden="true" />
          </span>
          <span>
            <span class="block text-[11px] leading-none text-muted">Respuesta rápida</span>
            <span class="text-xs font-bold text-ink">Por WhatsApp</span>
          </span>
        </div>
      </div>
    </div>
  </div>
</section>
